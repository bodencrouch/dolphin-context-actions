#!/usr/bin/make -f

%:
	dh $@ --with python3

override_dh_auto_install:
	dh_auto_install
	# Install Dolphin service menu .desktop files
	mkdir -p $(CURDIR)/debian/dolphin-convert-actions/usr/share/kio/servicemenus
	cp servicemenus/dolphin-convert-actions.desktop \
	   $(CURDIR)/debian/dolphin-convert-actions/usr/share/kio/servicemenus/
	cp servicemenus/dolphin-audio-converter.desktop \
	   $(CURDIR)/debian/dolphin-convert-actions/usr/share/kio/servicemenus/
